{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateLambdaLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "*"
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:sa-east-1:966725470611:log-group:/aws/lambda/marketpulse-start-ec2:*"
    },
    {
      "Sid": "DescribeTargetInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StartOnlyMarketPulseInstance",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:sa-east-1:966725470611:instance/i-010fb099cd62aa6bc"
    }
  ]
}
